{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "1. Start Databases (Docker)",
      "type": "shell",
      "command": "docker compose up postgres neo4j qdrant redis",
      "options": { "cwd": "${workspaceFolder}" },
      "group": "build",
      "presentation": { "panel": "new", "name": "Databases" },
      "problemMatcher": []
    },
    {
      "label": "2. Install Backend",
      "type": "shell",
      "command": "python -m venv venv && source venv/bin/activate && pip install -r requirements.txt",
      "windows": {
        "command": "python -m venv venv && venv\\Scripts\\activate && pip install -r requirements.txt"
      },
      "options": { "cwd": "${workspaceFolder}/backend" },
      "group": "build",
      "presentation": { "panel": "new", "name": "Backend Install" },
      "problemMatcher": []
    },
    {
      "label": "3. Start Backend",
      "type": "shell",
      "command": "source venv/bin/activate && uvicorn app.main:app --reload --port 8000",
      "windows": {
        "command": "venv\\Scripts\\activate && uvicorn app.main:app --reload --port 8000"
      },
      "options": { "cwd": "${workspaceFolder}/backend" },
      "group": "build",
      "presentation": { "panel": "new", "name": "Backend" },
      "problemMatcher": []
    },
    {
      "label": "4. Install Frontend",
      "type": "shell",
      "command": "npm install",
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "group": "build",
      "presentation": { "panel": "new", "name": "Frontend Install" },
      "problemMatcher": []
    },
    {
      "label": "5. Start Frontend",
      "type": "shell",
      "command": "npm run dev",
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "group": "build",
      "presentation": { "panel": "new", "name": "Frontend" },
      "problemMatcher": []
    },
    {
      "label": "SiteAI: Full Stack (Docker DB + Local Code)",
      "dependsOn": [
        "1. Start Databases (Docker)",
        "3. Start Backend",
        "5. Start Frontend"
      ],
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": []
    }
  ]
}
